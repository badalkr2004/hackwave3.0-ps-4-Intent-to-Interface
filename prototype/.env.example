# Database (provided by the team)
DATABASE_URL=
DB_SCHEMA=gestalt
ALLOW_DB_RESET=0

# LLM: models as provider:modelId. Set the key for each provider you use.
MODEL_FAST=google:gemini-3.8-flash
MODEL_WRITE=google:gemini-3.8-flash
# Optional secondary models when primary hits quota/capacity:
# MODEL_FAST_FALLBACK=groq:llama-3.1-8b-instant
# MODEL_WRITE_FALLBACK=groq:llama-3.1-8b-instant
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
# Example switches:
# MODEL_FAST=groq:openai/gpt-oss-120b
# MODEL_WRITE=openai:<model-id>
# MODEL_FAST=anthropic:claude-haiku-5-5

# App
PORT=8787
FORCE_FALLBACK=0
LOG_LEVEL=info
VITE_ENABLE_VOICE=0

# Auth (Better Auth + Drizzle). Optional — workspace works without sign-in.
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Browser-facing origin (Vite proxies /api → PORT in dev)
BETTER_AUTH_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
# Google OAuth Web Client (Better Auth + Meet connector).
# Create: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web).
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
# Enable APIs: Calendar, Google Drive, Google Meet, People.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Jira connector (Atlassian API token). Users still enter site URL + email in Connectors UI.
# Create a token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_KEY=
# Optional defaults for the Connectors form
# JIRA_BASE_URL=https://your-team.atlassian.net
# JIRA_EMAIL=you@company.com
# JIRA_PROJECT_KEY=ENG

# MCP: users create org-bound personal tokens in Connectors → IDE access (gst_mcp_…).
# No shared USER_ID in client config. Server only needs DATABASE_URL for token lookup.

# Optional chat RAG sidecar (repo-root ../rag). Leave unset — Gestalt keeps working without it.
# RAG_SERVICE_URL=http://127.0.0.1:8765
# RAG_API_KEY=dev-rag-key
# RAG also calls back to this Express app for live SQL context (meetings, tickets, schema).
# Set the same RAG_API_KEY in rag/.env and PROTOTYPE_API_URL=http://127.0.0.1:8787 there.
