{
  "name": "@gestalt/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "bun src/db/cli.ts migrate",
    "db:seed": "bun src/db/cli.ts seed",
    "db:reset": "bun src/db/cli.ts reset",
    "db:check": "bun src/db/check.ts",
    "llm:smoke": "bun src/llm/smoke.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.78",
    "@ai-sdk/groq": "^4.0.59",
    "@ai-sdk/openai": "^4.0.91",
    "@gestalt/shared": "workspace:*",
    "ai": "^7.0.137",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "postgres": "^3.4.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.0.0",
    "vitest": "^4.0.0"
  }
}
