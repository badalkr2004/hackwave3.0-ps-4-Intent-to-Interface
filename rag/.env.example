# Chat LLM — switch provider/model without code changes
LLM_PROVIDER=google_genai
LLM_MODEL=gemini-2.0-flash
# Optional fallback when primary fails
LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_MODEL=llama-3.3-70b-versatile

GOOGLE_API_KEY=
GROQ_API_KEY=

# Shared secret with Express proxy (optional in local demo)
RAG_API_KEY=dev-rag-key

# Express data plane — live meetings / tickets / usage / schema SQL snapshots
PROTOTYPE_API_URL=http://127.0.0.1:8787
PROTOTYPE_TIMEOUT_S=12

HOST=127.0.0.1
PORT=8765
CHROMA_DIR=data/chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
