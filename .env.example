# Database (provided by the team)
DATABASE_URL=
DB_SCHEMA=gestalt
ALLOW_DB_RESET=0

# LLM: models as provider:modelId. Set the key for each provider you use.
MODEL_FAST=anthropic:claude-haiku-5-5
MODEL_WRITE=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
# Example switch: MODEL_FAST=groq:<model-id>  MODEL_WRITE=openai:<model-id>

# App
PORT=8787
FORCE_FALLBACK=0
LOG_LEVEL=info
VITE_ENABLE_VOICE=0

# Auth (Better Auth + Drizzle). Optional — workspace works without sign-in.
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Browser-facing origin (Vite proxies /api → PORT in dev)
BETTER_AUTH_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
